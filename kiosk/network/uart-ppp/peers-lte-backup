# No usepeerdns -- the carrier's DNS servers aren't reachable except over
# this link itself, so accepting them would break resolution whenever
# WiFi (not LTE) is actually carrying traffic. DNS is instead handled by a
# static, link-independent resolv.conf -- see README.md.
__SERIAL_DEV__
__BAUD__
local
nocrtscts
noauth
lock
nodetach
persist
maxfail 0
holdoff 5
noipdefault
novj
novjccomp
connect "/usr/sbin/chat -v -f /etc/chatscripts/lte-backup.chat"
# Uncomment below if this SIM needs PAP/CHAP auth (Personal AR typically doesn't):
# user "..."
# password "..."
