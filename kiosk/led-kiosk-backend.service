# Install: sudo cp led-kiosk-backend.service /etc/systemd/system/
#          sudo systemctl enable --now led-kiosk-backend
# WAYLAND_DISPLAY/XDG_RUNTIME_DIR (not DISPLAY -- this device runs
# Wayland/labwc, confirmed on hardware, not X11) are needed for
# minimize_browser() in app/routes/system.py, which shells out to a Wayland
# window-management tool. wayland-0 and /run/user/1000 are this device's
# confirmed values (1000 = pi4's uid, check `id -u pi4` if redeployed to a
# different user).
# EnvironmentFile carries SMS_NOTIFY_NUMBERS (see app/sms.py) in from a
# file that's NOT part of this repo, so the numbers never get committed --
# create /etc/led-kiosk.env (root-owned, chmod 600) with a line like
# SMS_NOTIFY_NUMBERS=+5491122334455,+5491166778899
# The leading "-" makes it optional, so the service still starts (just
# without SMS) if that file hasn't been created yet.
[Unit]
Description=LED kiosk FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi4
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/1000
EnvironmentFile=-/etc/led-kiosk.env
WorkingDirectory=/home/pi4/led-kiosk
ExecStart=/home/pi4/led-kiosk/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
